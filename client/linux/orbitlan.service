[Unit]
Description=OrbitLan encrypted virtual LAN
Documentation=https://github.com/furqan-ahm/orbitlan/tree/main/client/linux
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/orbitlan/orbitlan.conf
ExecStart=/usr/local/bin/orbitlan -server ${ORBITLAN_SERVER} -relay ${ORBITLAN_RELAY} -edition ${ORBITLAN_EDITION} -code ${ORBITLAN_CODE} -name ${ORBITLAN_NAME} -adapter ${ORBITLAN_ADAPTER} -state-dir /var/lib/orbitlan -control-socket /run/orbitlan/control.sock
Restart=on-failure
RestartSec=5
User=root
UMask=0077
RuntimeDirectory=orbitlan
RuntimeDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/orbitlan

[Install]
WantedBy=multi-user.target
