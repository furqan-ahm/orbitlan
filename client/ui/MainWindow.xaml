<Window x:Class="OrbitLan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbitLan" Width="440" Height="660"
        Icon="orbitlan.ico"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_Drag">

    <Window.Resources>
        <!-- primary (Connect): full-width gradient, fixed height -->
        <Style TargetType="Button" x:Key="Primary">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3D5BDB" Offset="0"/>
                                    <GradientStop Color="#6C8CFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ghost (secondary): subtle filled, honors Padding/Height -->
        <Style TargetType="Button" x:Key="Ghost">
            <Setter Property="Background" Value="#1A2547"/>
            <Setter Property="Foreground" Value="#EDF0FF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22305A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text field wrapper -->
        <Style TargetType="Border" x:Key="Field">
            <Setter Property="Background" Value="#141C3D"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#222E56"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldText">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#EDF0FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#6C8CFF"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#8B93B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#070B1E" Offset="0"/>
                <GradientStop Color="#0D1430" Offset="0.55"/>
                <GradientStop Color="#16204A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas x:Name="StarsCanvas" IsHitTestVisible="False"/>
        <!-- soft planet glow anchoring the bottom -->
        <Ellipse Width="560" Height="560" Margin="0,0,0,-400" VerticalAlignment="Bottom"
                 HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.9">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#3D5BDB" Offset="0"/>
                    <GradientStop Color="#16204A" Offset="0.75"/>
                    <GradientStop Color="#0C1330" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <DockPanel Margin="26,18,26,22">
            <!-- header -->
            <Grid DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <UniformGrid Rows="2" Columns="2" Width="18" Height="18">
                        <Ellipse Fill="#EDF0FF" Margin="1.5"/><Ellipse Fill="#EDF0FF" Margin="1.5"/>
                        <Ellipse Fill="#EDF0FF" Margin="1.5"/><Ellipse Fill="#EDF0FF" Margin="1.5"/>
                    </UniformGrid>
                    <TextBlock Text="OrbitLan" Foreground="#EDF0FF" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#141C3D" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#8B93B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Offline" Foreground="#EDF0FF" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="⚙" Foreground="#8B93B8" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Settings_Click" ToolTip="Settings"/>
                    <TextBlock Text="—" Foreground="#8B93B8" FontSize="16" Margin="14,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Minimize_Click"/>
                    <TextBlock Text="✕" Foreground="#8B93B8" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- update banner -->
            <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                    Background="#1E2A55" CornerRadius="12" Padding="14,10" Margin="0,12,0,0"
                    BorderBrush="#324278" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="UpdateText" Text="Update available" Foreground="#EDF0FF" FontSize="13" FontWeight="Medium" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="UpdateSub" Text="Click to update and restart." Foreground="#8B93B8" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="UpdateBtn" Content="Update &amp; restart" Style="{StaticResource Ghost}"
                            Padding="14,9" VerticalAlignment="Center" Click="Update_Click"/>
                </Grid>
            </Border>

            <!-- content fills the rest of the window -->
            <Grid>
                <!-- ===================== SETUP (vertically centered) ===================== -->
                <StackPanel x:Name="SetupView" VerticalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Join a network" Foreground="#EDF0FF" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Everyone on the same code shares one LAN." Foreground="#8B93B8" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,6,0,26"/>

                    <TextBlock Text="Your name" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource Field}">
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldText}"/>
                    </Border>

                    <TextBlock Text="Network code" Style="{StaticResource Label}" Margin="2,18,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Field}">
                            <TextBox x:Name="CodeBox" Style="{StaticResource FieldText}" CharacterCasing="Lower"/>
                        </Border>
                        <Button Grid.Column="2" Content="New" Style="{StaticResource Ghost}" Width="70" Height="46" Click="New_Click"/>
                    </Grid>

                    <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource Primary}" Click="Connect_Click" Margin="0,26,0,0"/>
                    <TextBlock x:Name="SetupError" Foreground="#FF7A7A" FontSize="12" TextWrapping="Wrap" Margin="2,14,0,0" TextAlignment="Center"/>
                </StackPanel>

                <!-- ===================== CONNECTED (fills, list grows) ===================== -->
                <Grid x:Name="ConnectedView" Visibility="Collapsed" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- code card -->
                    <Border Grid.Row="0" Background="#141C3D" CornerRadius="18" Padding="18,15">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="NETWORK CODE" Foreground="#8B93B8" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CodeDisplay" Text="—" Foreground="#EDF0FF" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                                <TextBlock Text="Share this code so friends can join." Foreground="#5C6689" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Content="Copy" Style="{StaticResource Ghost}" Padding="16,9" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="Copy_Click"/>
                        </Grid>
                    </Border>

                    <!-- your IP + summary -->
                    <Border Grid.Row="1" Background="#141C3D" CornerRadius="14" Padding="16,12" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Your virtual IP" Foreground="#8B93B8" FontSize="12"/>
                                <TextBlock x:Name="MyIpText" Text="—" Foreground="#EDF0FF" FontSize="18" FontWeight="Medium"/>
                            </StackPanel>
                            <TextBlock x:Name="SummaryText" Text="" Foreground="#6C8CFF" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="PLAYERS" Foreground="#8B93B8" FontSize="11" FontWeight="SemiBold" Margin="4,18,0,8"/>

                    <!-- players list fills remaining space -->
                    <Border Grid.Row="3" Background="#0F1631" CornerRadius="16" Padding="6">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="MembersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,10" Margin="2" CornerRadius="12" Background="#141C3D">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding StatusBrush}"/>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="#EDF0FF" FontSize="15" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding IP}" Foreground="#8B93B8" FontSize="12"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding RttText}" Foreground="#8B93B8" FontSize="11" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyHint" Text="Waiting for friends to join with the code…"
                                       Foreground="#5C6689" FontSize="12" Margin="12" TextAlignment="Center"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Grid.Row="4" Content="Disconnect" Style="{StaticResource Ghost}" Click="Disconnect_Click"
                            Height="50" Margin="0,16,0,0"/>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ===================== SETTINGS OVERLAY ===================== -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#D0050A18" MouseLeftButtonDown="SettingsClose_Click">
            <Border Width="368" Background="#141C3D" CornerRadius="20" Padding="22"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#22305A" BorderThickness="1" MouseLeftButtonDown="Swallow">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Settings" Foreground="#EDF0FF" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="✕" Foreground="#8B93B8" FontSize="14" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="SettingsClose_Click"/>
                    </Grid>
                    <Border Height="1" Background="#22305A" Margin="0,14"/>

                    <TextBlock Text="Relay mode" Foreground="#EDF0FF" FontSize="15" FontWeight="Medium"/>
                    <TextBlock Text="Auto tries direct first. Off never uses relay. On forces relay for troubleshooting."
                               TextWrapping="Wrap" Foreground="#8B93B8" FontSize="12" Margin="0,5,0,8"/>
                    <ComboBox x:Name="RelayModeBox" Height="40" Padding="10,0" Background="#1A2547"
                              Foreground="#EDF0FF" BorderBrush="#2A3967" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Auto — direct first, relay if needed" Tag="auto"/>
                        <ComboBoxItem Content="Off — direct connections only" Tag="off"/>
                        <ComboBoxItem Content="On — force relay" Tag="on"/>
                    </ComboBox>

                    <TextBlock Text="Coordinator" Foreground="#EDF0FF" FontSize="15" FontWeight="Medium" Margin="0,15,0,0"/>
                    <TextBlock Text="Change this only when using a self-hosted coordinator."
                               TextWrapping="Wrap" Foreground="#8B93B8" FontSize="12" Margin="0,5,0,8"/>
                    <Border Style="{StaticResource Field}">
                        <TextBox x:Name="CoordinatorBox" Style="{StaticResource FieldText}" FontSize="12"/>
                    </Border>

                    <Border Height="1" Background="#22305A" Margin="0,16"/>
                    <TextBlock Text="Prioritize OrbitLan adapter" Foreground="#EDF0FF" FontSize="15" FontWeight="Medium"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#8B93B8" FontSize="12" Margin="0,5,0,0"
                               Text="Helps older games discover LAN sessions over the virtual adapter. Safe and reversible."/>
                    <Button x:Name="PriorityToggle" Content="Turn on" Style="{StaticResource Ghost}" Height="44"
                            Margin="0,12,0,0" Click="PriorityToggle_Click"/>
                    <TextBlock x:Name="PriorityStatus" Text="Currently: off (Windows default)" Foreground="#8B93B8"
                               FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"/>

                    <TextBlock x:Name="SettingsError" Foreground="#FF7A7A" FontSize="11" Margin="2,10,0,0"
                               TextWrapping="Wrap"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SupportBtn" Grid.Column="0" Content="Support" Style="{StaticResource Ghost}"
                                Height="42" Click="Support_Click"/>
                        <Button Grid.Column="2" Content="Save" Style="{StaticResource Ghost}" Height="42"
                                Click="SettingsSave_Click"/>
                    </Grid>
                    <TextBlock x:Name="VersionText" Text="OrbitLan" Foreground="#5C6689" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
